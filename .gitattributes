# Shell scripts must stay LF — CRLF breaks bash on Linux/macOS.
# These are BY EXTENSION on purpose: path-scoped rules (.claude/hooks/*.sh) left
# templates/*.sh and every *.py uncovered, so on a Windows dev machine
# core.autocrlf gave them CRLF working copies — and `npm publish` packs the
# WORKING TREE. v5.12.0/5.13.0/5.13.1 all shipped templates/agentvibes-receiver.sh
# with a `#!/usr/bin/env bash\r` shebang, which dies on Linux/macOS with
# "env: 'bash\r': No such file or directory".
*.sh text eol=lf
*.py text eol=lf
bin/* text eol=lf
# PowerShell is Windows-only and wants CRLF. By extension so templates/*.ps1 and
# the root setup-*.ps1 are covered too, not just .claude/hooks-windows/.
*.ps1 text eol=crlf

# Standard text files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.bats text eol=lf

# Binary files — no line ending conversion
*.wav binary
*.mp3 binary
*.aiff binary
*.onnx binary
*.png binary
*.jpg binary
