{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.github/hooks/init-agentvibes.sh\"",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path (git rev-parse --show-toplevel 2>$null) '.github\\hooks\\init-agentvibes.ps1')",
        "timeoutSec": 10,
        "comment": "Initialize AgentVibes TTS for Copilot session"
      }
    ]
  }
}
